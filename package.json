{
  "name": "picwrap",
  "version": "0.1.0",
  "description": "Upload photos, get a shareable gallery page. Cloudflare Workers + KV.",
  "scripts": {
    "build:client": "esbuild src/client/upload.ts src/client/gallery.ts --bundle --format=esm --target=es2020 --minify --outdir=public/js",
    "build": "npm run build:client && wrangler deploy --dry-run --outdir dist",
    "dev": "npm run build:client && wrangler dev",
    "typecheck": "tsc",
    "lint": "eslint .",
    "test": "vitest run",
    "check": "npm run typecheck && npm run lint && npm test && npm run build",
    "deploy": "npm run build:client && wrangler deploy"
  },
  "license": "UNLICENSED",
  "type": "module",
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "esbuild": "^0.28.2",
    "eslint": "^10.13.0",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.72.1",
    "vitest": "^4.1.12",
    "wrangler": "^4.86.0"
  },
  "private": true
}
